# ==========================================
# NIVARA Backend Environment Example
# ==========================================

# Core Application Settings
PROJECT_NAME="NIVARA AI Communication, Learning & Safety System"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Server Network Configuration
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS="http://localhost:3000,http://localhost:8080,http://localhost:8083,http://localhost:19006,http://127.0.0.1:8083,*"

# Database Settings (MongoDB)
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="nivara_db"
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=100

# Security & JWT Authentication
SECRET_KEY="your_super_secret_32byte_jwt_key_here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# Wearable Safety & Geofencing
GEOFENCE_DEFAULT_RADIUS_METERS=500.0
